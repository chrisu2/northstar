# Text files are stored with LF line endings.
* text=auto eol=lf

# Binary assets.
*.tga binary
*.ttf binary
*.png binary

# Downloaded source tables keep their bytes exactly as fetched.
tests/fixtures/data/sources/** -text

# Generated files: collapsed in diffs and left out of the language statistics.
# Each one is rebuilt by a `node tools/polestar.js` command; edit the generator, not the file.
addon/Northstar_Guides/** linguist-generated
addon/Northstar_ItemDB/*.lua linguist-generated
addon/Northstar_[a-z][a-z][A-Z][A-Z]/** linguist-generated
addon/Northstar/Core/ClassTrainers.lua linguist-generated
addon/Northstar/Gear/SpecData.lua linguist-generated
addon/Northstar/Maps/ZoneLevels.lua linguist-generated
addon/Northstar/Nav/TravelData.lua linguist-generated
addon/Northstar/QoL/Data.lua linguist-generated
addon/Northstar/UI/ZoneArtOverlays.lua linguist-generated
docs/preview/*.svg linguist-generated
docs/assets/**/*.svg linguist-generated

# Northstar's walking maps, generated by `node tools/polestar.js nav pack`
# (PACK.json and tests/nav-maps.test.js check them); never edit by hand.
addon/Northstar_Nav/Nav/** linguist-generated
